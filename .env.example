# Configuración de servidor para Supabase (MVP de la PWA de inspecciones).
# Copia este archivo a .env.local y completa los valores reales.
# No se versionan secretos: .env* está en .gitignore; solo .env.example viaja en git.

# URL del proyecto Supabase (p. ej. https://abc12345.supabase.co).
SUPABASE_URL=

# Anon key pública del proyecto Supabase.
# Usa la clave "anon", nunca service_role: las peticiones autenticadas van con la identidad del usuario.
SUPABASE_ANON_KEY=