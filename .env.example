# Configuración de servidor para Supabase (MVP de la PWA de inspecciones).
# Copia este archivo a .env.local y completa los valores reales.
# No se versionan secretos: .env* está en .gitignore; solo .env.example viaja en git.

# URL HTTPS canónica sin ruta, credenciales, query ni fragmento.
# HTTP sólo para localhost, 127.0.0.1 o [::1] en desarrollo/arneses locales.
SUPABASE_URL=

# Clave pública sb_publishable_* o JWT legado con role anon.
# Nunca service_role, sb_secret_* ni tokens de usuario; no usar NEXT_PUBLIC_*.
# Las peticiones autenticadas van con la identidad del usuario.
SUPABASE_ANON_KEY=
